PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/incidentledger
JWT_SECRET=your_jwt_secret_here
PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY_URL=gateway.mypinata.cloud

# Hyperledger Fabric Configuration
FABRIC_CHANNEL_NAME=incidentchannel
FABRIC_CHAINCODE_NAME=incident-ledger
FABRIC_MSP_ID=Org1MSP
FABRIC_APP_USER=appUser
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.incidentledger.com

# Windows Event Collector Settings (Live Security Log Monitor)
WINDOWS_EVENT_COLLECTION_ENABLED=true
WINDOWS_EVENT_POLL_INTERVAL_MS=5000
WINDOWS_EVENT_LOGS=Security,System,Application
WINDOWS_EVENT_START_FROM_LATEST=true
